# Proxy settings for Bazel
# Replace the placeholder values with your actual proxy host and port
test --host_jvm_args=-DsocksProxyHost=your.proxy.host --host_jvm_args=-DsocksProxyPort=your.proxy.port
test --host_jvm_args=-Dhttp.proxyHost=your.proxy.host --host_jvm_args=-Dhttp.proxyPort=your.proxy.port
test --host_jvm_args=-Dhttps.proxyHost=your.proxy.host --host_jvm_args=-Dhttps.proxyPort=your.proxy.port